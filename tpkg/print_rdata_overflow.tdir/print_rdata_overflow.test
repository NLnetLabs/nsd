# #-- print_rdata_overflow.test --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test
. ../common.sh
PRE="../.."
TPKG_CONTROL="$PRE/nsd-control -c nsd.conf"

$TPKG_CONTROL write
sleep 1
if [ ! -f evil.test ]; then
	echo "Error: zone file not written"
	exit 1
fi
if ! grep -q 'SVCB.*key65533=".*"$' evil.test; then
	echo "Error: zone file truncated"
	exit 1
fi
