# #-- nsec3_soa_params.test --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test

. ../common.sh
PRE="../.."

echo ""
echo "> dig a.example.com DS +dnssec"
dig @127.0.0.1 -p $TPKG_PORT a.example.com DS +dnssec > cur
cat cur
# see if there is answer, with a SOA record in the authority section
# if it failed, it returned no answer.
if grep "root.example.com" cur; then
	echo "OK"
else
	echo "not OK"
	exit 1
fi

echo "OK"
exit 0
