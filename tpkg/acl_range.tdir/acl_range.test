# #-- bug056_axfr.test --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test

PRE="../../"
N_ERRORS=0

# should work
for DOMAIN in example.nl example.com example.net; do
	dig @127.0.0.1 -p $TPKG_PORT ${DOMAIN}. AXFR > dig.out
	if ! grep -q "^$DOMAIN" dig.out; then
		echo "IPv4 $DOMAIN acl failed"
		N_ERRORS=`expr $N_ERRORS + 1`
	fi
	dig @::1 -p $TPKG_PORT ${DOMAIN}. AXFR > dig.out
	if ! grep -q "^$DOMAIN" dig.out; then
		echo "IPv6 $DOMAIN acl failed"
		N_ERRORS=`expr $N_ERRORS + 1`
	fi
done

# should not work
for DOMAIN in example.org; do
	dig @127.0.0.1 -p $TPKG_PORT ${DOMAIN}. AXFR > dig.out
	if grep -q "^$DOMAIN" dig.out; then
		echo "IPv4 $DOMAIN acl failed"
		N_ERRORS=`expr $N_ERRORS + 1`
	fi
	dig @::1 -p $TPKG_PORT ${DOMAIN}. AXFR > dig.out
	if grep -q "^$DOMAIN" dig.out; then
		echo "IPv6 $DOMAIN acl failed"
		N_ERRORS=`expr $N_ERRORS + 1`
	fi
done

if [ $N_ERRORS -gt 0 ]; then
	exit 1
fi

exit 0
