# #-- control_reconfig_waitudp.test --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test

. ../common.sh
PRE="../.."

# Phase 1: request AXFR from testns1.
for((i=0; i<$NUM_ZONES; i++)); do
	wait_logfile nsd.log "zone example$i.com serial 0 is updated to 1" 10
done
echo "> zones updated with AXFR"
echo ""

# Phase 2: reconfig to blackhole, testns2.
mv edit.conf edit1.conf
mv edit2.conf edit.conf
echo "> reconfig edit2.conf"
$PRE/nsd-control -c edit.conf reconfig

# wait for refresh timer.
sleep 11

# Phase 3: reconfig to changed primary, testns3.
mv edit.conf edit2.conf
mv edit3.conf edit.conf
echo "> reconfig edit3.conf"
$PRE/nsd-control -c edit.conf reconfig

# Test that zones are updated, and NSD does not crash.
echo ""
for((i=0; i<$NUM_ZONES; i++)); do
	wait_logfile nsd.log "zone example$i.com serial 1 is updated to 3" 30
done
echo "> zones are updated"
echo ""

# test that server is up
echo ""
echo "> dig a.example1.com"
dig @127.0.0.1 -p $TPKG_PORT a.example1.com A > cur
cat cur
if grep "10.0.0.3" cur; then
	echo "OK"
else
	echo "not OK"
	exit 1
fi

echo "OK"
exit 0
