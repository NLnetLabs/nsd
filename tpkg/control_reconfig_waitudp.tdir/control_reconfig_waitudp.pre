# #-- control_reconfig_waitudp.pre--#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test
. ../common.sh

# start NSD
get_random_port 4
TPKG_PORT=$RND_PORT
TESTNS1_PORT=`expr $RND_PORT + 1`
TESTNS2_PORT=`expr $RND_PORT + 2`
TESTNS3_PORT=`expr $RND_PORT + 3`

PRE="../.."
TPKG_NSD="$PRE/nsd"

# create config
# With some chance the random order makes the waiting list
# elements happen first during the remote control loop that changes
# the zones. The waiting list order is random due to randomized timeouts.
# The number has to be above 128.
NUM_ZONES=180
NSD_CTRL_PATH=$(realpath $(dirname ${0}))/nsd-control.pipe

sed -e "s/TESTNS_PORT/"$TESTNS1_PORT"/" \
	 -e "s#NSD_CTRL_PATH#${NSD_CTRL_PATH}#" \
	 < control_reconfig_waitudp.conf > edit.conf
sed -e "s/TESTNS_PORT/"$TESTNS2_PORT"/" \
	 -e "s#NSD_CTRL_PATH#${NSD_CTRL_PATH}#" \
	< control_reconfig_waitudp.conf > edit2.conf
sed -e "s/TESTNS_PORT/"$TESTNS3_PORT"/" \
	 -e "s#NSD_CTRL_PATH#${NSD_CTRL_PATH}#" \
	< control_reconfig_waitudp.conf > edit3.conf
for((i=0; i<$NUM_ZONES; i++)); do
cat >>zones.conf <<EOF

zone:
	name: "example$i.com"
	include-pattern: "pat"
EOF
done

# create testns files.
for((i=0; i<$NUM_ZONES; i++)); do
	cat >>ns1.testns <<EOF

# reply AXFR request, for example$i.com
ENTRY_BEGIN
MATCH opcode qtype qname
REPLY QUERY NOERROR
ADJUST copy_id
SECTION QUESTION
example$i.com. IN AXFR
SECTION ANSWER
example$i.com. 345600 IN SOA ns0.example.org. root 1 10 5 2419200 3600
a.example$i.com. 3600 IN A 10.0.0.1
example$i.com. 345600 IN SOA ns0.example.org. root 1 10 5 2419200 3600
ENTRY_END
EOF

	cat >>ns2.testns <<EOF
# no answer for example$i.com
EOF

	cat >>ns3.testns <<EOF

# reply IXFR request, for example$i.com
ENTRY_BEGIN
MATCH opcode qtype qname serial=1
REPLY QUERY NOERROR
ADJUST copy_id
SECTION QUESTION
example$i.com IN IXFR
SECTION ANSWER
example$i.com. 345600 IN SOA ns0.example.org. root 3 10 5 2419200 3600
a.example$i.com. 3600 IN A 10.0.0.3
example$i.com. 345600 IN SOA ns0.example.org. root 3 10 5 2419200 3600
ENTRY_END
EOF
done

# start testns
ldns-testns -p $TESTNS1_PORT ns1.testns >testns1.log 2>&1 &
TESTNS1_PID=$!
wait_ldns_testns_up testns1.log

ldns-testns -p $TESTNS2_PORT ns2.testns >testns2.log 2>&1 &
TESTNS2_PID=$!
wait_ldns_testns_up testns2.log

ldns-testns -p $TESTNS3_PORT ns3.testns >testns3.log 2>&1 &
TESTNS3_PID=$!
wait_ldns_testns_up testns3.log

# share the vars
echo "export TPKG_PORT=$TPKG_PORT" >> .tpkg.var.test
echo "export TESTNS1_PORT=$TESTNS1_PORT" >> .tpkg.var.test
echo "export TESTNS2_PORT=$TESTNS2_PORT" >> .tpkg.var.test
echo "export TESTNS3_PORT=$TESTNS3_PORT" >> .tpkg.var.test
echo "export TESTNS1_PID=$TESTNS1_PID" >> .tpkg.var.test
echo "export TESTNS2_PID=$TESTNS2_PID" >> .tpkg.var.test
echo "export TESTNS3_PID=$TESTNS3_PID" >> .tpkg.var.test
echo "export NUM_ZONES=$NUM_ZONES" >> .tpkg.var.test
echo "NSD_CTRL_PATH=${NSD_CTRL_PATH}" >> .tpkg.var.test

$TPKG_NSD -d -c edit.conf -u "" -p $TPKG_PORT -l /dev/stderr 2>&1 | tee nsd.log &
wait_nsd_up nsd.log
