# #-- caa_empty_tag.test --#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test
. ../common.sh

sleep .1
if dig @127.0.0.1 -p $TPKG_PORT example.com. CAA | grep -q ' ANSWER: 0, '; then
	exit 0
else
	cat testns.log
	cat nsd.log
	dig @127.0.0.1 -p $TPKG_PORT example.com. CAA
	echo "CAA was loaded in zone"
	exit 1
fi

