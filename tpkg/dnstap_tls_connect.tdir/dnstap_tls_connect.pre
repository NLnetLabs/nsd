# #-- dnstap_tls_connect.pre--#
# source the master var file when it's there
[ -f ../.tpkg.var.master ] && source ../.tpkg.var.master
# use .tpkg.var.test for in test variable passing
[ -f .tpkg.var.test ] && source .tpkg.var.test
. ../common.sh
PRE="../.."

if grep "define USE_DNSTAP " $PRE/config.h; then
	echo "USE_DNSTAP enabled"
else
	echo "USE_DNSTAP not enabled, skip test"
	exit 0
fi

# Is unbound-dnstap-socket available?
if test -f "`which unbound-dnstap-socket 2>&1`"; then
	echo "unbound-dnstap-socket available, do test"
else
	echo "unbound-dnstap-socket not available, skip test"
	exit 0
fi
# The unbound-dnstap-socket tool is in path. It is from make from unbound tests.

# start NSD
get_random_port 2
TPKG_PORT=$RND_PORT
DNSTAP_PORT=`expr $RND_PORT + 1`

TPKG_NSD="$PRE/nsd"

# share the vars
echo "export TPKG_PORT=$TPKG_PORT" >> .tpkg.var.test
echo "export DNSTAP_PORT=$DNSTAP_PORT" >> .tpkg.var.test

sed -e "s/PORT1/$TPKG_PORT/" \
    -e "s/PORT2/$DNSTAP_PORT/" \
	< dnstap_tls_connect.conf > edit.conf
echo "nsd on port $TPKG_PORT"

# The dnstap server uses the nsd_server key and pem file, that are used
# in other tests for the TLS identity for NSD.
unbound-dnstap-socket -t 127.0.0.1@$DNSTAP_PORT -x nsd_server.key -y nsd_server.pem -l -v >dnstap.log 2>&1 &
DNSTAP_PID=$!
wait_logfile dnstap.log "start of service" 15
echo "export DNSTAP_PID=$DNSTAP_PID" >> .tpkg.var.test

$TPKG_NSD -c edit.conf -u "" -p $TPKG_PORT -V 6
wait_nsd_up nsd.log
