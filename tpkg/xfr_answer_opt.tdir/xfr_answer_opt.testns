#!
# premade query answers

$ORIGIN example.com.
$TTL 3600

# reply IXFR request, with AXFR content.
ENTRY_BEGIN
MATCH opcode qtype qname serial=1
REPLY QUERY NOERROR
ADJUST copy_id
SECTION QUESTION
@ IN IXFR
SECTION ANSWER
@ 345600 IN SOA ns0.example.org. root 3 3600 28800 2419200 3600
a	3600	IN	A	10.0.0.1
# an OPT RR in the answer section, this is malformed content.
. 0 CLASS4096 OPT \# 00
b	3600	IN	A	10.0.0.2
c	3600	IN	A	10.0.0.3
@ 345600 IN SOA ns0.example.org. root 3 3600 28800 2419200 3600
ENTRY_END
