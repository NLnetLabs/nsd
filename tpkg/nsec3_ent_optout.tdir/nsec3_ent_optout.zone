$ORIGIN example.com.
$TTL 3600

; This zone is optout.
; The DNSKEY is from the unbound testdata keys.

example.com. IN SOA ns1.example.com. bugs.x.w.example.com. 1 3600 300 3600000 3600
example.com.	3600	IN	RRSIG	SOA 8 2 3600 20261007005010 20260909005010 29332 example.com. 
example.com. NS      ns1.example.
example.com. NS      ns2.example.
example.com.	3600	IN	RRSIG	NS 8 2 3600 20261007005010 20260909005010 29332 example.com. 

example.com.	IN	DNSKEY	257 3 8  ;{id = 29332 (ksk), size = 2048b}
example.com.	3600	IN	RRSIG	DNSKEY 8 2 3600 20261007005010 20260909005010 29332 example.com. 

example.com. NSEC3PARAM 1 0 0 -
example.com.	3600	IN	RRSIG	NSEC3PARAM 8 2 3600 20261007005010 20260909005010 29332 example.com. 

; example.com. -> onib9mgub9h0rml3cdf5bgrj59dkjhvk.
onib9mgub9h0rml3cdf5bgrj59dkjhvk.example.com. NSEC3 1 1 0 - onib9mgub9h0rml3cdf5bgrj59dkjhvl DNSKEY NS SOA NSEC3PARAM RRSIG
onib9mgub9h0rml3cdf5bgrj59dkjhvk.example.com.	3600	IN	RRSIG	NSEC3 8 3 3600 20261007005010 20260909005010 29332 example.com. 

